# Environment Variables for Fuel Route Optimizer API

# ── Routing Engine ──────────────────────────────────────────────────────────
# Default is 'geoapify' if GEOAPIFY_API_KEY is provided, or 'osrm' (keyless).
ROUTING_ENGINE=geoapify

# ── Geoapify API Key ────────────────────────────────────────────────────────
# Get your free key from https://www.geoapify.com/ (3,000 requests/day free)
GEOAPIFY_API_KEY=your_geoapify_api_key_here

# ── Optional: OpenRouteService (ORS) ────────────────────────────────────────
ORS_API_KEY=

# ── Django Settings ─────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=django-insecure-fuel-route-api-change-me
DEBUG=True
