# Environment Variables for Fuel Route Optimizer API

# ── Routing Engine ──────────────────────────────────────────────────────────
# Default is 'osrm' (Open Source Routing Machine).
# 100% FREE, NO API KEY NEEDED. Works out of the box!
ROUTING_ENGINE=osrm

# ── Optional: OpenRouteService (ORS) ────────────────────────────────────────
# Only needed if you explicitly set ROUTING_ENGINE=ors
ORS_API_KEY=

# ── Django Settings ─────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=django-insecure-fuel-route-api-change-me
DEBUG=True
